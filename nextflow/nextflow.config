// Defaults match config/project.sh so every executor produces the same analysis.
params {
    samples               = "${projectDir}/../config/samples.tsv"
    outdir                = 'results-nf'
    run_type              = 'full'        // full | subsample_smoke
    reference_dir         = null          // reuse a prebuilt Bowtie2 reference directory
    genome_fasta          = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/analysisSet/hg38.analysisSet.fa.gz'
    genome_md5            = '6d3c82e1e12b127d526395294526b9c8'
    blacklist             = 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/d0527cdea356bf57d30535b48783804ca8d21031/lists/hg38-blacklist.v2.bed.gz'
    blacklist_sha256      = 'c92e763af17271446194991e71917ac220593a5a3d40a06667be24178ef08cf2'
    mapq                  = 30
    max_insert            = 2000
    qvalue                = 0.01
    genrich_pvalue        = 0.01
    seed                  = 42
    effective_genome_size = 2913022398

    // Caps for small machines; requests above these are lowered, not rejected.
    max_cpus              = 16
    max_memory            = '128.GB'
    max_time              = '48.h'

    container             = 'atac-peak-callers:1.0'
    conda_env             = "${projectDir}/../env/environment.yml"
    aws_region            = 'us-east-1'
    aws_queue             = null
    aws_cli_path          = '/home/ec2-user/miniconda/bin/aws'
}

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] && task.attempt < 3 ? 'retry' : 'terminate' }
    maxRetries    = 2
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory as MemoryUnit, time: params.max_time as Duration]

    withLabel: reference  { cpus = 8; memory = { 48.GB * task.attempt }; time = 8.h }
    withLabel: preprocess { cpus = 8; memory = { 32.GB * task.attempt }; time = 18.h }
    withLabel: caller     { cpus = 1 }
    withLabel: summarize  { cpus = 1; memory = { 12.GB * task.attempt }; time = 4.h }
}

profiles {
    conda {
        conda.enabled  = true
        process.conda  = params.conda_env
    }
    docker {
        docker.enabled    = true
        process.container = params.container
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = params.container
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'general'
        process.clusterOptions = '--account=general --qos=normal'
    }
    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = params.aws_queue
        process.container = params.container
        aws.region        = params.aws_region
        aws.batch.cliPath = params.aws_cli_path
    }
    test {
        params.run_type = 'subsample_smoke'
    }
}

manifest {
    name            = 'atac-peak-caller-comparison'
    description     = 'MACS3, Genrich, and HMMRATAC on paired-end ATAC-seq'
    nextflowVersion = '>=24.04'
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
